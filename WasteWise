function calculateImpact(method) {
  const wasteType = document.getElementById('calcWasteType').value;
  const quantity = parseInt(document.getElementById('calcQuantity').value) || 1;
  const data = impactData[wasteType];
  const impact = data[method];
  const totalCo2 = (impact.co2 * quantity).toFixed(1);
  const totalWater = impact.water * quantity;
  const totalWaste = (impact.waste * quantity * 100).toFixed(0);

  const resultDiv = document.getElementById('calcResult');
  const comparisonDiv = document.getElementById('calcComparison');

  comparisonDiv.innerHTML = `
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1rem; margin-bottom: 1rem;">
      <div style="text-align: center; padding: 1rem; background: rgba(34,197,94,0.1); border-radius: 8px;">
        <div style="font-size: 1.5rem; font-weight: 800; color: var(--green-bright);">${totalCo2}kg</div>
        <div style="color: var(--muted); font-size: 0.8rem;">CO₂ Emissions</div>
      </div>
      <div style="text-align: center; padding: 1rem; background: rgba(59,130,246,0.1); border-radius: 8px;">
        <div style="font-size: 1.5rem; font-weight: 800; color: var(--blue);">${totalWater}L</div>
        <div style="color: var(--muted); font-size: 0.8rem;">Water Usage</div>
      </div>
      <div style="text-align: center; padding: 1rem; background: rgba(245,158,11,0.1); border-radius: 8px;">
        <div style="font-size: 1.5rem; font-weight: 800; color: var(--amber);">${totalWaste}%</div>
        <div style="color: var(--muted); font-size: 0.8rem;">Waste Volume</div>
      </div>
    </div>
    <div style="color: var(--muted); font-size: 0.9rem; text-align: center;">
      ${method === 'recycle' ? '♻️ Recycling saves resources and reduces environmental impact!' :
        method === 'compost' ? '🌱 Composting returns nutrients to the soil!' :
        method === 'incinerate' ? '🔥 Incineration reduces waste volume but releases CO₂' :
        '🏭 Landfill is the least environmentally friendly option'}
    </div>
  `;

  resultDiv.style.display = 'block';
}

// ===== COMMUNITY TIPS =====
let communityTips = safeGet('communityTips', []);
if (communityTips.length === 0) {
  communityTips = [{
    id: Date.now(),
    author: 'Anonymous',
    content: 'Started using cloth bags for shopping. Saved money and reduced plastic waste!',
    likes: 12,
    timestamp: new Date().toISOString()
  }];
  safeSet('communityTips', communityTips);
}

function shareTip() {
  const tipText = document.getElementById('tipInput').value.trim();
  if (!tipText) return;

  const tip = {
    id: Date.now(),
    author: 'Anonymous User',
    content: tipText,
    likes: 0,
    timestamp: new Date().toISOString()
  };

  communityTips.unshift(tip);
  if (communityTips.length > 10) communityTips = communityTips.slice(0, 10);
  safeSet('communityTips', communityTips);
  document.getElementById('tipInput').value = '';
  renderCommunityTips();
}

function renderCommunityTips() {
  const container = document.getElementById('communityTips');
  container.innerHTML = communityTips.map(tip => `
    <div class="community-tip">
      <div class="tip-author">👤 ${tip.author}</div>
      <div class="tip-content">"${tip.content}"</div>
      <div class="tip-actions">
        <button onclick="likeTip(${tip.id})" class="like-btn">👍 ${tip.likes}</button>
      </div>
    </div>
  `).join('');
}

function likeTip(tipId) {
  const tip = communityTips.find(t => t.id === tipId);
  if (tip) {
    tip.likes++;
    safeSet('communityTips', communityTips);
    renderCommunityTips();
  }
}

// ===== INTEGRATION WITH EXISTING FUNCTIONS =====
const originalRenderResult = renderResult;
renderResult = function(r) {
  originalRenderResult(r);

  const today = new Date().getDay();
  weeklyData[today]++;
  wasteData.push(r);

  if (wasteData.length > 100) wasteData = wasteData.slice(-100);
  if (weeklyData[today] > 50) weeklyData[today] = 50;

  safeSet('wasteData', wasteData);
  safeSet('weeklyData', weeklyData);

  updateDashboard();

  userStats.points += r.isWaste ? 10 : 5;
  if (r.recyclable === 'Yes') userStats.points += 5;
  if (r.hazardLevel === 'High') userStats.points += 15;

  updateUserStats();
};

// ===== DOM CONTENT LOADED - SETUP ALL EVENT LISTENERS =====
document.addEventListener('DOMContentLoaded', function() {
  // Load saved API key
  const saved = safeGet('or_key', '');
  if (saved) {
    const apiKeyInput = document.getElementById('apiKeyInput');
    if (apiKeyInput) apiKeyInput.value = saved;
    setKeyStatus('Key loaded.', 'var(--green-bright)');
  }

  // Setup drag and drop for all upload zones
  function setupDropZone(zoneId, handler) {
    const zone = document.getElementById(zoneId);
    if (!zone) return;
    zone.addEventListener('dragover', e => { e.preventDefault(); zone.classList.add('drag-over'); });
    zone.addEventListener('dragleave', () => zone.classList.remove('drag-over'));
    zone.addEventListener('drop', e => {
      e.preventDefault(); 
      zone.classList.remove('drag-over');
      handler(e);
    });
  }

  setupDropZone('dropZone', (e) => {
    const file = e.dataTransfer.files[0];
    if (file && file.type.startsWith('image/')) loadImageFile(file);
  });
  setupDropZone('bulkDropZone', (e) => {
    const files = e.dataTransfer.files;
    if (files.length) onBulkFileSelect({ target: { files: files } });
  });
  setupDropZone('reportDropZone', (e) => {
    const file = e.dataTransfer.files[0];
    if (file && file.type.startsWith('image/')) onReportFileSelect({ target: { files: [file] } });
  });

  // Calculator buttons
  document.querySelectorAll('.calc-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      document.querySelectorAll('.calc-btn').forEach(b => b.classList.remove('active'));
      e.target.classList.add('active');
      calculateImpact(e.target.dataset.method);
    });
  });

  // Initialize all components
  updateDashboard();
  renderCommunityTips();
  renderScheduledPickups();
  renderMarketplaceListings();
  renderUserStats();

  // Scroll progress bar
  window.addEventListener('scroll', function() {
    const scrollTop = window.pageYOffset;
    const docHeight = document.body.offsetHeight - window.innerHeight;
    const scrollPercent = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
    const progressBar = document.getElementById('scrollProgressBar');
    if (progressBar) progressBar.style.width = scrollPercent + '%';
  });
});
</script>
</body>
</html>

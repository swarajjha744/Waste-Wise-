function updateDashboard() {
  const stats = wasteData.reduce((acc, item) => {
    acc.total++;
    if (item.recyclable === 'Yes') acc.recyclable++;
    if (item.wasteType && item.wasteType.toLowerCase().includes('organic')) acc.organic++;
    if (item.hazardLevel === 'High' || item.hazardLevel === 'Medium') acc.hazardous++;
    if (item.recyclable === 'Yes') {
      acc.co2Saved += 0.5;
      acc.waterSaved += 2;
    }
    return acc;
  }, { total: 0, recyclable: 0, organic: 0, hazardous: 0, co2Saved: 0, waterSaved: 0 });

  document.getElementById('totalWaste').textContent = stats.total;
  document.getElementById('recyclableCount').textContent = stats.recyclable;
  document.getElementById('organicCount').textContent = stats.organic;
  document.getElementById('hazardousCount').textContent = stats.hazardous;
  document.getElementById('carbonFootprint').textContent = stats.co2Saved.toFixed(1);
  document.getElementById('waterSaved').textContent = stats.waterSaved;

  const co2SavedEl = document.getElementById('co2Saved');
  const waterSavedDisplayEl = document.getElementById('waterSavedDisplay');
  const landfillSavedEl = document.getElementById('landfillSaved');

  if (co2SavedEl) co2SavedEl.textContent = stats.co2Saved.toFixed(1) + ' kg';
  if (waterSavedDisplayEl) waterSavedDisplayEl.textContent = stats.waterSaved + ' L';
  if (landfillSavedEl) landfillSavedEl.textContent = (stats.total * 0.3).toFixed(1) + ' kg';

  updateWeeklyChart();
}

function updateWeeklyChart() {
  const canvas = document.getElementById('weeklyChart');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const width = canvas.width;
  const height = canvas.height;
  const maxVal = Math.max(...weeklyData, 1);

  ctx.clearRect(0, 0, width, height);
  ctx.fillStyle = 'rgba(34,197,94,0.2)';
  ctx.strokeStyle = '#22c55e';
  ctx.lineWidth = 2;

  weeklyData.forEach((val, i) => {
    const barHeight = (val / maxVal) * (height - 40);
    const barWidth = (width - 60) / 7;
    const x = 30 + i * barWidth;
    const y = height - 30 - barHeight;

    ctx.fillRect(x, y, barWidth - 2, barHeight);
    ctx.strokeRect(x, y, barWidth - 2, barHeight);

    ctx.fillStyle = '#6b9e7c';
    ctx.font = '10px sans-serif';
    ctx.textAlign = 'center';
    ctx.fillText(['M','T','W','T','F','S','S'][i], x + barWidth/2, height - 10);
    ctx.fillStyle = 'rgba(34,197,94,0.2)';
  });
}

function resetDashboard() {
  if (confirm('Reset all tracking data? This cannot be undone.')) {
    wasteData = [];
    weeklyData = [0,0,0,0,0,0,0];
    safeSet('wasteData', wasteData);
    safeSet('weeklyData', weeklyData);
    updateDashboard();
  }
}


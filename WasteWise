// ===== GAMIFICATION & REWARDS =====
let userStats = safeGet('userStats', { points: 0, level: 1, streak: 0, badges: [], challenges: [] });
let badges = [
  { id: 'first-scan', name: 'First Scan', description: 'Scanned your first waste item', icon: '🔍', requirement: 1 },
  { id: 'recycling-hero', name: 'Recycling Hero', description: 'Recycled 10 items', icon: '♻️', requirement: 10 },
  { id: 'waste-warrior', name: 'Waste Warrior', description: 'Scanned 50 items', icon: '⚔️', requirement: 50 },
  { id: 'eco-champion', name: 'Eco Champion', description: 'Reached level 5', icon: '👑', requirement: 5 }
];

function updateUserStats() {
  userStats.level = Math.floor(userStats.points / 100) + 1;

  badges.forEach(badge => {
    if (!userStats.badges.includes(badge.id)) {

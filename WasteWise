async function getFreeVisionModels(apiKey) {
  try {
    const res = await fetch('https://openrouter.ai/api/v1/models', {
      headers: { 'Authorization': 'Bearer ' + apiKey }
    });
    if (!res.ok) return null;
    const data = await res.json();
    const freeVision = data.data.filter(m => {
      const isFree = m.id.endsWith(':free');
      const hasVision = m.architecture && m.architecture.input_modalities && m.architecture.input_modalities.includes('image');
      return isFree && hasVision;
    }).map(m => m.id);
    return freeVision.length > 0 ? freeVision : null;
  } catch(e) { return null; }
}

async function tryModel(apiKey, model, prompt) {
  const res = await fetch('https://openrouter.ai/api/v1/chat/completions', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'Authorization': 'Bearer ' + apiKey,
      'HTTP-Referer': window.location.href,
      'X-Title': 'WasteWise AI'
    },
    body: JSON.stringify({
      model: model,
      messages: [{ role: 'user', content: [
        { type: 'image_url', image_url: { url: 'data:' + currentMediaType + ';base64,' + currentImageBase64 } },
        { type: 'text', text: prompt }
      ]}],
      temperature: 0.1,
      max_tokens: 800
    })
  });
  if (res.status === 401) throw new Error('INVALID_KEY');
  if (!res.ok) {
    const e = await res.json().catch(() => ({}));
    throw new Error((e.error && e.error.message) || 'HTTP ' + res.status);
  }
  const data = await res.json();
  const raw = data.choices && data.choices[0] && data.choices[0].message && data.choices[0].message.content;
  if (!raw) throw new Error('Empty response');
  const clean = raw.replace(/```json/g,'').replace(/```/g,'').trim();
  const s = clean.indexOf('{'), e2 = clean.lastIndexOf('}');
  if (s === -1 || e2 === -1) throw new Error('No JSON in response');
  return JSON.parse(clean.slice(s, e2 + 1));
}


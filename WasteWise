function generateAuditReport() {
  const orgName = document.getElementById('orgName').value.trim();
  const employeeCount = parseInt(document.getElementById('employeeCount').value) || 1;
  const paperWaste = parseFloat(document.getElementById('paperWaste').value) || 0;
  const plasticWaste = parseFloat(document.getElementById('plasticWaste').value) || 0;
  const organicWaste = parseFloat(document.getElementById('organicWaste').value) || 0;
  const ewasteAmount = parseFloat(document.getElementById('ewasteAmount').value) || 0;

  if (!orgName) {
    alert('Please enter organization name');
    return;
  }

  const totalWaste = paperWaste + plasticWaste + organicWaste + ewasteAmount;
  const wastePerPerson = totalWaste / employeeCount;
  const recyclableWaste = paperWaste + plasticWaste;
  const recyclingPotential = totalWaste > 0 ? (recyclableWaste / totalWaste * 100) : 0;
  
  const landfillCostPerKg = 5;
  const recyclingRevenuePerKg = 8;
  const compostingCostPerKg = 3;
  const annualSavings = (recyclableWaste * recyclingRevenuePerKg) + (organicWaste * compostingCostPerKg) - (totalWaste * landfillCostPerKg);

  const totalWasteEl = document.getElementById('totalWasteWeek');
  const wastePerPersonEl = document.getElementById('wastePerPerson');
  const recyclingPotentialEl = document.getElementById('recyclingPotential');
  const costSavingsEl = document.getElementById('costSavings');

  if (totalWasteEl) totalWasteEl.textContent = totalWaste.toFixed(1);
  if (wastePerPersonEl) wastePerPersonEl.textContent = wastePerPerson.toFixed(1);
  if (recyclingPotentialEl) recyclingPotentialEl.textContent = recyclingPotential.toFixed(0);
  if (costSavingsEl) costSavingsEl.textContent = Math.max(0, annualSavings * 52).toLocaleString();

  const recommendations = [];
  if (recyclingPotential < 50) recommendations.push("Implement a comprehensive recycling program to increase recycling rate above 50%");
  if (paperWaste > plasticWaste * 2) recommendations.push("Focus on paper recycling - consider digital documentation to reduce paper usage");
  if (organicWaste > totalWaste * 0.3) recommendations.push("Set up composting facility for organic waste to reduce landfill contributions");
  if (ewasteAmount > 0) recommendations.push("Partner with certified e-waste recyclers for responsible electronics disposal");
  if (wastePerPerson > 2) recommendations.push("Implement waste reduction strategies - aim for less than 2kg waste per person per week");
  recommendations.push("Conduct regular waste audits (quarterly) to track progress");
  recommendations.push("Train staff on waste segregation at source");

  const recEl = document.getElementById('auditRecommendations');
  if (recEl) recEl.innerHTML = recommendations.map(rec => `<li>${rec}</li>`).join('');

  const co2Savings = recyclableWaste * 2.5;
  const landfillReduction = totalWaste * 0.8;
  const waterSavings = recyclableWaste * 5;

  const impactEl = document.getElementById('auditImpact');
  if (impactEl) {
    impactEl.innerHTML = `
      <p>By implementing recommended waste management practices, your organization could:</p>
      <ul style="margin-top:0.5rem;padding-left:1.2rem;">
        <li>Save approximately ${co2Savings.toFixed(0)} kg of CO₂ emissions annually</li>
        <li>Reduce landfill contributions by ${landfillReduction.toFixed(0)} kg per week</li>
        <li>Conserve ${waterSavings.toFixed(0)} liters of water through recycling</li>
        <li>Contribute to India's goal of 80% waste processing by 2030</li>
      </ul>
    `;
  }

  const reportEl = document.getElementById('auditReport');
  if (reportEl) {
    reportEl.style.display = 'block';
    reportEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
}


<script>
// ===== SAFE LOCALSTORAGE =====
function safeGet(key, def) {
  try {
    const item = localStorage.getItem(key);
    return item ? JSON.parse(item) : def;
  } catch(e) { return def; }
}
function safeSet(key, val) {
  try { localStorage.setItem(key, JSON.stringify(val)); } catch(e) {}
}

let currentImageBase64 = null;
let currentMediaType = 'image/jpeg';
let cameraStream = null;
let bulkImageIdCounter = 0;

// ===== WASTE COLLECTION SCHEDULER =====
let scheduledPickups = safeGet('scheduledPickups', []);
let collectionHistory = safeGet('collectionHistory', []);

function schedulePickup() {
  const category = document.getElementById('wasteCategory').value;
  const date = document.getElementById('pickupDate').value;
  const time = document.getElementById('pickupTime').value;
  const quantity = document.getElementById('wasteQuantity').value;

  if (!date || !quantity) {
    alert('Please fill in all fields');
    return;
  }

  const pickup = {
    id: Date.now(),
    category,
    date,
    time,
    quantity: parseInt(quantity),
    status: 'scheduled',
    createdAt: new Date().toISOString()
  };

  scheduledPickups.push(pickup);
  safeSet('scheduledPickups', scheduledPickups);

  document.getElementById('pickupDate').value = '';
  document.getElementById('wasteQuantity').value = '';

  renderScheduledPickups();
  alert('Pickup scheduled successfully!');
}

function renderScheduledPickups() {
  const container = document.getElementById('upcomingPickups');
  if (scheduledPickups.length === 0) {
    container.innerHTML = '<div style="text-align: center; color: var(--muted); padding: 2rem;">No scheduled pickups</div>';
    return;
  }

  container.innerHTML = scheduledPickups
    .filter(p => new Date(p.date) >= new Date())
    .sort((a, b) => new Date(a.date) - new Date(b.date))
    .slice(0, 5)
    .map(pickup => `
      <div style="background: var(--bg); border: 1px solid var(--border); border-radius: 8px; padding: 1rem; margin-bottom: 0.5rem;">
        <div style="display: flex; justify-content: space-between; align-items: start;">
          <div>
            <div style="color: #fff; font-weight: 600;">${pickup.category.charAt(0).toUpperCase() + pickup.category.slice(1)} Waste</div>
            <div style="color: var(--muted); font-size: 0.9rem;">${new Date(pickup.date).toLocaleDateString()} • ${pickup.time}</div>
            <div style="color: var(--green-bright); font-size: 0.9rem;">${pickup.quantity} kg</div>
          </div>
          <button onclick="cancelPickup(${pickup.id})" style="background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.3); color: #fca5a5; padding: 4px 8px; border-radius: 4px; cursor: pointer; font-size: 0.8rem;">Cancel</button>
        </div>
      </div>
    `).join('');

  renderCollectionHistory();
}

function cancelPickup(id) {
  scheduledPickups = scheduledPickups.filter(p => p.id !== id);
  safeSet('scheduledPickups', scheduledPickups);
  renderScheduledPickups();
}

function renderCollectionHistory() {
  const container = document.getElementById('collectionHistory');
  if (collectionHistory.length === 0) {
    container.innerHTML = '<div style="text-align: center; color: var(--muted); padding: 1rem;">No collection history</div>';
    return;
  }

  container.innerHTML = collectionHistory
    .sort((a, b) => new Date(b.completedAt) - new Date(a.completedAt))
    .slice(0, 10)
    .map(item => `
      <div style="display: flex; justify-content: space-between; align-items: center; padding: 0.5rem 0; border-bottom: 1px solid var(--border);">
        <div>
          <div style="color: #fff; font-size: 0.9rem;">${item.category.charAt(0).toUpperCase() + item.category.slice(1)} Waste</div>
          <div style="color: var(--muted); font-size: 0.8rem;">${new Date(item.completedAt).toLocaleDateString()}</div>
        </div>
        <div style="color: var(--green-bright); font-weight: 600;">${item.quantity} kg</div>
      </div>
    `).join('');
}

// ===== BULK WASTE ANALYSIS =====
let bulkImages = [];

function onBulkFileSelect(evt) {
  const files = Array.from(evt.target.files);
  if (files.length > 10) {
    alert('Maximum 10 images allowed');
    return;
  }

  files.forEach((file) => {
    if (file.type.startsWith('image/')) {
      const reader = new FileReader();
      reader.onload = e => {
        bulkImages.push({
          id: bulkImageIdCounter++,
          file,
          base64: e.target.result.split(',')[1],
          mediaType: file.type,
          preview: e.target.result
        });
        renderBulkPreview();
      };
      reader.readAsDataURL(file);
    }
  });
}

function renderBulkPreview() {
  const preview = document.getElementById('bulkPreview');
  preview.innerHTML = bulkImages.map(img => `
    <div style="position: relative;">
      <img src="${img.preview}" style="width: 100%; height: 100px; object-fit: cover; border-radius: 8px; border: 1px solid var(--border);">
      <button onclick="removeBulkImage(${img.id})" style="position: absolute; top: -5px; right: -5px; background: #ef4444; color: white; border: none; border-radius: 50%; width: 20px; height: 20px; cursor: pointer; font-size: 12px;">×</button>
    </div>
  `).join('');
}

function removeBulkImage(id) {
  bulkImages = bulkImages.filter(img => img.id !== id);
  renderBulkPreview();
}

function clearBulkImages() {
  bulkImages = [];
  document.getElementById('bulkPreview').innerHTML = '';
  document.getElementById('bulkFileInput').value = '';
  document.getElementById('bulkResults').style.display = 'none';
}

async function analyzeBulkWaste() {
  if (bulkImages.length === 0) {
    alert('Please select images first');
    return;
  }

  const apiKey = (safeGet('or_key', '') || document.getElementById('apiKeyInput').value).trim();
  if (!apiKey || !apiKey.startsWith('sk-or-')) {
    alert('Please set your OpenRouter API key first');
    return;
  }

  const btn = document.getElementById('analyzeBulkBtn');
  btn.disabled = true;
  btn.textContent = 'Analyzing...';

  const results = [];
  for (let i = 0; i < bulkImages.length; i++) {
    const img = bulkImages[i];
    try {
      const result = await analyzeSingleImage(apiKey, img.base64, img.mediaType);
      results.push({ ...result, imageIndex: i });
    } catch (error) {
      results.push({ error: error.message, imageIndex: i });
    }
  }

  renderBulkResults(results);
  btn.disabled = false;
  btn.textContent = 'Analyze All Images';
}

async function analyzeSingleImage(apiKey, base64, mediaType) {
  const prompt = 'You are a waste management AI. Analyse this image. Reply ONLY with a raw JSON object: {"isWaste":true,"wasteType":"Plastic Waste","subCategory":"PET Bottle","confidence":"High","hazardLevel":"Low","recyclable":"Yes","binColour":"Blue (Dry Recyclables)","description":"2 sentences","disposalSteps":["Step 1","Step 2"],"environmentalImpact":"2 sentences","emoji":"♻️"}';

  const FALLBACK_MODELS = ['qwen/qwen2.5-vl-72b-instruct:free', 'qwen/qwen2.5-vl-32b-instruct:free'];

  for (const model of FALLBACK_MODELS) {
    try {
      const res = await fetch('https://openrouter.ai/api/v1/chat/completions', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': 'Bearer ' + apiKey,
          'HTTP-Referer': window.location.href,
          'X-Title': 'WasteWise AI'
        },
        body: JSON.stringify({
          model: model,
          messages: [{ role: 'user', content: [
            { type: 'image_url', image_url: { url: 'data:' + mediaType + ';base64,' + base64 } },
            { type: 'text', text: prompt }
          ]}],
          temperature: 0.1,
          max_tokens: 800
        })
      });

      if (res.ok) {
        const data = await res.json();
        const raw = data.choices[0].message.content;
        const clean = raw.replace(/```json/g,'').replace(/```/g,'').trim();
        const s = clean.indexOf('{'), e = clean.lastIndexOf('}');
        return JSON.parse(clean.slice(s, e + 1));
      }
    } catch (e) {}
  }
  throw new Error('Analysis failed');
}

function renderBulkResults(results) {
  const container = document.getElementById('bulkResults');
  if (!container) return;

  container.style.display = 'block';

  const summary = results.reduce((acc, r) => {
    if (!r.error) {
      acc.total++;
      if (r.recyclable === 'Yes') acc.recyclable++;
      if (r.hazardLevel === 'High' || r.hazardLevel === 'Medium') acc.hazardous++;
    }
    return acc;
  }, { total: 0, recyclable: 0, hazardous: 0 });

  const summaryEl = document.getElementById('bulkSummary');
  if (summaryEl) {
    summaryEl.innerHTML = `
      <div style="text-align: center; padding: 1rem; background: rgba(34,197,94,0.1); border-radius: 8px;">
        <div style="font-size: 1.5rem; font-weight: 800; color: var(--green-bright);">${summary.total}</div>
        <div style="color: var(--muted); font-size: 0.8rem;">Total Items</div>
      </div>
      <div style="text-align: center; padding: 1rem; background: rgba(59,130,246,0.1); border-radius: 8px;">
        <div style="font-size: 1.5rem; font-weight: 800; color: var(--blue);">${summary.recyclable}</div>
        <div style="color: var(--muted); font-size: 0.8rem;">Recyclable</div>
      </div>
      <div style="text-align: center; padding: 1rem; background: rgba(245,158,11,0.1); border-radius: 8px;">
        <div style="font-size: 1.5rem; font-weight: 800; color: var(--amber);">${summary.hazardous}</div>
        <div style="color: var(--muted); font-size: 0.8rem;">Hazardous</div>
      </div>
    `;
  }

  const detailsEl = document.getElementById('bulkDetails');
  if (detailsEl) {
    detailsEl.innerHTML = results.map((result, index) => `
      <div style="background: var(--bg); border: 1px solid var(--border); border-radius: 12px; padding: 1rem; margin-bottom: 1rem;">
        <div style="display: flex; gap: 1rem; align-items: start;">
          <img src="${bulkImages[index].preview}" style="width: 80px; height: 80px; object-fit: cover; border-radius: 8px; border: 1px solid var(--border);">
          <div style="flex: 1;">
            ${result.error ? 
              `<div style="color: #ef4444;">Analysis failed: ${result.error}</div>` :
              `<div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 0.5rem;">
                <div>
                  <div style="color: #fff; font-weight: 600;">${result.wasteType}</div>
                  <div style="color: var(--muted); font-size: 0.9rem;">${result.subCategory} • ${result.confidence} confidence</div>
                </div>
                <div style="font-size: 1.5rem;">${result.emoji}</div>
              </div>
              <div style="color: var(--text); font-size: 0.9rem; margin-bottom: 0.5rem;">${result.description}</div>
              <div style="display: flex; gap: 0.5rem;">
                <span class="hazard-tag ${result.hazardLevel.toLowerCase() === 'high' ? 'hazard-high' : result.hazardLevel.toLowerCase() === 'medium' ? 'hazard-med' : 'hazard-low'}">${result.hazardLevel}</span>
                <span style="background: ${result.recyclable === 'Yes' ? 'rgba(34,197,94,0.15)' : 'rgba(239,68,68,0.15)'}; color: ${result.recyclable === 'Yes' ? 'var(--green-pale)' : '#fca5a5'}; padding: 3px 10px; border-radius: 6px; font-size: 0.75rem; font-weight: 600;">${result.recyclable === 'Yes' ? 'Recyclable' : 'Not Recyclable'}</span>
              </div>`
            }
          </div>
        </div>
      </div>
    `).join('');
  }
}

